---
import { getCollection, getEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sectionEntry = await getEntry('sections', `products-${lang}`);
const { title, subtitle } = sectionEntry.data;

const allProducts = await getCollection('products', ({ data }) => {
  return data.lang === lang;
});

const sortedProducts = allProducts.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="products" class="py-16 md:py-24 bg-white border-t border-slate-100 scroll-mt-24">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10 md:mb-16 px-4">
      <h2 class="text-2xl sm:text-4xl md:text-6xl lg:text-7xl font-sans font-black text-[#154360] tracking-tighter leading-tight">
        {title}
      </h2>
    </div>

    <div class="relative overflow-hidden w-full py-6 md:py-10 before:absolute before:left-0 before:top-0 before:z-10 before:h-full before:w-12 before:sm:w-24 before:bg-gradient-to-r before:from-white before:to-transparent after:absolute after:right-0 after:top-0 after:z-10 after:h-full after:w-12 after:sm:w-24 after:bg-gradient-to-l after:from-white after:to-transparent">
      <div class="flex animate-scroll hover:[animation-play-state:paused] whitespace-nowrap gap-8 md:gap-14 w-max items-center">
        {/* Original List */}
        {sortedProducts.map((p) => (
          <a 
            href={`${base}/${lang}/products/${p.id.split('/').pop()?.replace('.md', '')}`}
            class="shrink-0 group relative py-4 px-4 sm:px-6 md:py-8 md:px-10 transition-all duration-500 opacity-60 hover:opacity-100 flex items-center justify-center min-w-[150px] sm:min-w-[200px] md:min-w-[260px] h-20 md:h-28"
          >
            {p.data.logo ? (
              <img 
                src={`${base}${p.data.logo}`} 
                alt={p.data.title} 
                class="max-h-12 sm:max-h-16 md:max-h-20 w-auto max-w-full object-contain transition-transform duration-500 group-hover:scale-110"
              />
            ) : (
              <span class="text-[#154360] font-sans font-black text-base sm:text-xl md:text-3xl tracking-tighter ">
                {p.data.title.split(' ')[0]}
              </span>
            )}
          </a>
        ))}
        {/* Duplicate list for seamless loop */}
        {sortedProducts.map((p) => (
          <a 
            href={`${base}/${lang}/products/${p.id.split('/').pop()?.replace('.md', '')}`}
            class="shrink-0 group relative py-4 px-4 sm:px-6 md:py-8 md:px-10 transition-all duration-500 opacity-60 hover:opacity-100 flex items-center justify-center min-w-[150px] sm:min-w-[200px] md:min-w-[260px] h-20 md:h-28"
          >
            {p.data.logo ? (
              <img 
                src={`${base}${p.data.logo}`} 
                alt={p.data.title} 
                class="max-h-12 sm:max-h-16 md:max-h-20 w-auto max-w-full object-contain transition-transform duration-500 group-hover:scale-110"
              />
            ) : (
              <span class="text-[#154360] font-sans font-black text-base sm:text-xl md:text-3xl tracking-tighter ">
                {p.data.title.split(' ')[0]}
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-50% - 28px)); } 
  }
  .animate-scroll {
    animation: scroll 40s linear infinite;
  }
  @media (max-width: 768px) {
    .animate-scroll {
      animation: scroll 25s linear infinite;
    }
  }
</style>
